STANHEADERS_SRC = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "message()" -e "cat(system.file('include', 'src', package = 'StanHeaders', mustWork = TRUE))" -e "message()" | grep "StanHeaders")

STANC_FLAGS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "cat(ifelse(utils::packageVersion('rstan') >= '2.26', '-DUSE_STANC3',''))")
PKG_CPPFLAGS = -I"../inst/include" -I"$(STANHEADERS_SRC)" -DBOOST_DISABLE_ASSERTS -DEIGEN_NO_DEBUG -DBOOST_MATH_OVERFLOW_ERROR_POLICY=errno_on_error $(STANC_FLAGS) -D_HAS_AUTO_PTR_ETC=0
PKG_CXXFLAGS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "RcppParallel::CxxFlags()") $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "StanHeaders:::CxxFlags()")

# Deliberately omits StanHeaders:::LdFlags() (unlike the Unix Makevars):
# that function unconditionally emits "-L<TBB_LIB> -Wl,-rpath,<TBB_LIB>
# -ltbb -ltbbmalloc", which assumes RcppParallel ships a *dynamic*
# tbb.dll/tbbmalloc.dll -- true for older RcppParallel releases, but
# RcppParallel >= 6.0.0 links TBB statically on Windows and no longer
# reliably provides those at the expected path, and "-Wl,-rpath" has no
# effect on Windows regardless (it's an ELF/Unix mechanism). The result
# was our own compiled EpiStrainDynamics.dll failing to load at runtime
# with "LoadLibrary failure: The specified module could not be found"
# for tbb.dll. RcppParallel::RcppParallelLibs() alone already provides
# whatever linking its own installed version actually needs -- this is
# confirmed by rstan's own from-source Windows build linking only
# -lRcppParallel with no separate TBB flags at all.
PKG_LIBS = $(shell "$(R_HOME)/bin$(R_ARCH_BIN)/Rscript" -e "RcppParallel::RcppParallelLibs()")

CXX_STD = CXX17

# Lower optimisation from R's Windows default (-O2) to -O1. Compiling the
# heavy Eigen/Boost/StanHeaders template instantiations in each
# stanExports_*.cc at -O2 can exhaust cc1plus's available memory on
# GitHub-hosted Windows runners; -O1 keeps compiled models fast enough
# while substantially reducing peak compiler memory.
#
# Two earlier attempts at this failed:
#  - Setting CXXFLAGS directly: wrong variable, since CXX_STD = CXX17
#    routes compilation through CXX17FLAGS instead.
#  - Setting CXX17FLAGS with a plain assignment, and separately
#    appending -O1 to PKG_CXXFLAGS: R's own etc/Makeconf is included
#    *after* Makevars.win (per "Writing R Extensions") and assembles
#    ALL_CXXFLAGS with PKG_CXXFLAGS positioned *before* CXX17FLAGS, so
#    Makeconf's own plain `=` assignment to CXX17FLAGS always ends up
#    both later in inclusion order and later in the command line,
#    silently winning either way.
#
# The `override` directive is immune to being reset by any later plain
# assignment, regardless of inclusion order, which is exactly what's
# needed here.
#
# -O1 alone (this override confirmed working via CI logs, dropping -O2
# entirely) did not fix the Windows failure on its own. Also add -w to
# suppress compiler warnings: Eigen/Boost/StanHeaders headers emit an
# enormous volume of template-instantiation warnings under -Wall
# (190,000+ log lines for a single file), and Windows named pipes have
# far smaller buffers than Unix -- a plausible cause of the observed
# "Error in proc$get_built_file(): Build process failed" is the R-side
# monitoring process losing sync with the compiler's stdout under that
# volume, independent of actual memory exhaustion.
override CXX17FLAGS = -O1 -w -mfpmath=sse -msse2 -mstackrealign
